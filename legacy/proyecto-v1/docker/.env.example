# Copie este archivo como docker/.env y reemplace todos los valores.
MYSQL_DATABASE=observabilidad
MYSQL_USER=cambiar_usuario
MYSQL_PASSWORD=cambiar_por_clave_larga
MYSQL_ROOT_PASSWORD=cambiar_por_otra_clave_larga
API_WRITE_KEY=cambiar_por_token_aleatorio_de_32_caracteres
SECURITY_FLOOD_REQUESTS=30
SECURITY_BLOCK_SECONDS=60
# Solo acepta X-Demo-Source desde loopback; desactivar fuera de la defensa controlada.
SECURITY_DEMO_MODE=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
URL_MONITOREADA=http://127.0.0.1:8080/
MONITORED_SERVICE=sitio-vigilado
MONITORED_SERVER=localhost
MONITOR_EXPECTED_TEXT=Servicio web vigilado operativo
MONITOR_TIMEOUT_MS=30000
LATENCY_THRESHOLD_MS=1500
MAX_REMEDIATION_ATTEMPTS=2
REMEDIATION_COOLDOWN_SECONDS=300
MAX_ESTABLISHED_CONNECTIONS=1000
# SSH_CHECK_HOST y SSH_CHECK_PORT son opcionales; solo validan banner, no ejecutan comandos.
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, SMTP_FROM y SMTP_TO son opcionales.
